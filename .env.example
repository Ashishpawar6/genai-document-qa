# Copy this file to ".env" and fill in your own values. ".env" is git-ignored, so your key is never committed.
#
# --- Optional: turn on full AI answers ---------------------------------------------------------
# Without a key the app still works as a document SEARCH tool (it shows the best matching passages).
# With a key it also WRITES an answer from those passages and cites them.
# Get a key at https://console.anthropic.com/ (Settings -> API Keys). Usage is billed to your account.
ANTHROPIC_API_KEY=

# --- Optional settings (defaults shown) --------------------------------------------------------
# Model used for written answers. The default is the most capable model; for lower cost try
# claude-sonnet-5-5 or claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort: low | medium | high | xhigh | max. Defaults to "low" on models that support it.
# ANTHROPIC_EFFORT=low
# ANTHROPIC_MAX_TOKENS=8000

# Retrieval settings
# DOCQA_CHUNK_SIZE=900
# DOCQA_CHUNK_OVERLAP=150
# DOCQA_TOP_K=4
# DOCQA_DATA_DIR=data
# Embeddings: "fastembed" (default, local model, downloaded on first use) or "hashing" (tiny, offline, tests only)
# DOCQA_EMBEDDINGS=fastembed
